# Kopyala: cp .env.example .env  (.env git'e eklenmez, .gitignore'da)
# Bu dosyada yalnızca yer tutucu değerler vardır. Gerçek şifreleri buraya veya Git'e yazmayın.

# docker-compose: dq-postgres ve dwh-monitor servisleri bu şifreyi kullanır (zorunlu).
DQ_DB_PASSWORD=replace-with-strong-password

# Veritabanı parolaları (config/databases.yaml, ${NAME} ile okunur; hepsi zorunlu).
ETL_MSSQL_PASSWORD=replace-with-mssql-password
ETL_MYSQL_PASSWORD=replace-with-mysql-password
ETL_MARIADB_PASSWORD=replace-with-mariadb-password
ETL_ORACLE_PASSWORD=replace-with-oracle-password
ETL_ODBC_PASSWORD=replace-with-odbc-password

# Bildirim kanalları (config/notifications.yaml, ${NAME} ile okunur; hepsi zorunlu).
SMTP_PASSWORD=replace-with-smtp-password
WEBHOOK_TOKEN=replace-with-webhook-token

# Vault (dev modunda docker-compose bu token'ı kullanır; prod'da servis hesabı token'ı).
VAULT_TOKEN=replace-with-vault-token

# scripts/vault-init.py çalıştırılmadan önce ortamda ayarlanmalıdır (hepsi zorunlu).
DB_MSSQL_PROD_PASS=replace-with-mssql-prod-password
DB_MYSQL_PROD_PASS=replace-with-mysql-prod-password
DB_MARIADB_PROD_PASS=replace-with-mariadb-prod-password
DB_ORACLE_PROD_PASS=replace-with-oracle-prod-password
DB_POSTGRES_LOCAL_PASS=replace-with-postgres-local-password
