# Kopyala: cp .env.example .env  (.env git'e eklenmez, .gitignore'da)
# Tüm değerler yer tutucudur; gerçek değerleri yalnızca .env veya
# ortam değişkeni olarak ver. Yapılandırma dosyaları ${NAME} ile okur.

# Veritabanı parolaları (config/databases.yaml)
DQ_DB_PASSWORD=CHANGE_ME
ETL_MSSQL_PASSWORD=CHANGE_ME
ETL_MYSQL_PASSWORD=CHANGE_ME
ETL_MARIADB_PASSWORD=CHANGE_ME
ETL_ORACLE_PASSWORD=CHANGE_ME
ETL_ODBC_PASSWORD=CHANGE_ME

# Bildirim kanalları (config/notifications.yaml)
SMTP_PASSWORD=CHANGE_ME
WEBHOOK_TOKEN=CHANGE_ME

# Vault (docs/config/docker-compose.yml)
VAULT_TOKEN=CHANGE_ME
